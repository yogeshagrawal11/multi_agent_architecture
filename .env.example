# Default local configuration for the banking multi-agent app
# Copy this file to .env before running the app locally.

APP_ENV=demo
APP_HOST=0.0.0.0
APP_PORT=8000

OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_COORDINATOR=gpt-oss:120b
LLM_SUBAGENT=gpt-oss:120b
LLM_EMBED=nomic-embed-text
LLM_TIMEOUT_SECONDS=120
THIRDPARTY_LLM_ENABLED=false

DATA_DIR=/data
BANK_DB=/data/bank.db
SESSIONS_DB=/data/sessions.db

JWT_SECRET=change-me-demo-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RATE_LIMIT_PER_SECOND=4
